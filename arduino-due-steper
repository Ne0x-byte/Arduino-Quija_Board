#include <AccelStepper.h>

// ================================
// Motores 28BYJ-48 con ULN2003
// ================================

// Motor 1
AccelStepper motor1(
  AccelStepper::FULL4WIRE,
  A8, A10, A9, A11
);

// Motor 2
AccelStepper motor2(
  AccelStepper::FULL4WIRE,
  A4, A6, A5, A7
);

// 45 grados ≈ 256 pasos
const int PASOS_45 = 256;

String buffer = "";

bool motorEnMovimiento = false;
bool regresando = false;
unsigned long pausaInicio = 0;

// ================================
void setup() {
  Serial.begin(115200);
  Serial2.begin(9600);

  randomSeed(analogRead(A0));

  motor1.setMaxSpeed(30);
  motor1.setAcceleration(10);

  motor2.setMaxSpeed(14);
  motor2.setAcceleration(10);

  Serial.println("DUE listo - Solo Steppers");
}

// ================================
void loop() {

  // -------- UART --------
  while (Serial2.available()) {
    char c = Serial2.read();

    if (c == '\n') {
      buffer.trim();

      if (buffer == "TIKFINITY_EVENT" && !motorEnMovimiento) {
        iniciarMovimiento();
      }

      buffer = "";
    } else {
      buffer += c;
    }
  }

  // -------- Motores --------
  motor1.run();
  motor2.run();

  if (motorEnMovimiento) {
    controlarMovimiento();
  }
}

// ================================
// INICIAR MOVIMIENTO
// ================================
void iniciarMovimiento() {

  int direccion = random(0, 2) == 0 ? -1 : 1;
  int pasos = direccion * PASOS_45;

  motor1.moveTo(pasos);
  motor2.moveTo(pasos);

  motorEnMovimiento = true;
  regresando = false;
}

// ================================
// CONTROLAR STEPPERS
// ================================
void controlarMovimiento() {

  // Cuando llegan al primer destino
  if (!regresando &&
      motor1.distanceToGo() == 0 &&
      motor2.distanceToGo() == 0) {

    pausaInicio = millis();
    regresando = true;
  }

  // Después de pequeña pausa regresan
  if (regresando &&
      millis() - pausaInicio > 300) {

    motor1.moveTo(0);
    motor2.moveTo(0);

    regresando = false;
  }

  // Cuando regresan completamente
  if (!regresando &&
      motor1.distanceToGo() == 0 &&
      motor2.distanceToGo() == 0) {

    motorEnMovimiento = false;
  }
}
